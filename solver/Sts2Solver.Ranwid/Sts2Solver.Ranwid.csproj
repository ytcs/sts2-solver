<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10 (only this exe): Terminal.Gui v2 ships net10.0-only. A net10 app can still reference the net9
         Engine/Content/Search libraries (backward compatible), so the rest of the solution stays on net9. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sts2Solver.Ranwid</RootNamespace>
    <AssemblyName>ranwid</AssemblyName>
    <!-- Advice fans hundreds of independent, allocation-heavy MCTS solves across cores; Server GC's per-core
         heaps + parallel collection roughly doubles that parallel throughput vs Workstation GC (measured). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!-- Win32 version resource + assembly metadata. A self-contained single-file .NET exe with BLANK metadata
         is a known antivirus false-positive trigger (it reads like an anonymous packed binary), so populate it.
         Keep these accurate to the shipped build; bump Version per release. -->
    <Version>0.107.0</Version>
    <FileVersion>0.107.0</FileVersion>
    <AssemblyVersion>0.107.0</AssemblyVersion>
    <Company>Steven</Company>
    <Product>ranwid</Product>
    <Authors>Steven</Authors>
    <Description>ranwid — live advisor for an ongoing Slay the Spire 2 run. Reads the save file only; never modifies the game.</Description>
    <Copyright>Copyright © 2026 Steven</Copyright>
    <!-- Compression makes the single-file bundle look packed to AV heuristics — leave it OFF on publish. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sts2Solver.Engine/Sts2Solver.Engine.csproj" />
    <ProjectReference Include="../Sts2Solver.Content/Sts2Solver.Content.csproj" />
    <ProjectReference Include="../Sts2Solver.Search/Sts2Solver.Search.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="Terminal.Gui" Version="2.4.4" />
  </ItemGroup>
</Project>
