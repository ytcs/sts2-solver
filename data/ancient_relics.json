{
 "_conventions": {
  "scope": "every relic an ancient can offer (the pools and relics of all 8 ancients in data/ancients.json, Neow and Darv included)",
  "effects": "the relic's PICKUP effects (AfterObtained) in the agent/events.py vocabulary, applied in order after the relic is appended (agent.events.apply_ancient). The relic's combat effect is the simulator's and is not listed; [] = no pickup effect. An ongoing non-combat effect that the vocabulary cannot express is an 'unmodelled' note (a no-op that flags the rollout)",
  "ascension": "no ancient relic reads the ascension level (none of the 102 classes references Ascension); the numbers hold at A10",
  "placeholders": "card_add 'STRIKE_{character}' / 'DEFEND_{character}' name the run's character's basic card; card_add_random pool 'others' = each offered card from a different other character's pool, 'other' = one random other character's pool shared by every effect of the option",
  "params": "card_transform {n ('all'), match (id prefix or list), basic, upgraded, to, map {card: card}}; card_enchant {id, n ('all'), amount, type, match, basic, random}; card_upgrade int or {n, match, basic}; card_add_random {..., rarity 'Ancient', exclude, upgraded}; card_add_one_of + n (distinct); relic_one_of + n (distinct, not owned) + pickup (each relic's own pickup effects); relic_replace {held: replacement}; potion_slots n (st.slots += n)",
  "titles": "English titles from ancient option labels in runs/*/events.jsonl where seen, else the id in title case with possessives (Neow's, Pael's ...); Sea Glass's in-game title carries the character (SeaGlass.cs:25-35), matched by containment",
  "src": "decomp/MegaCrit.Sts2.Core.Models.Relics/<Class>.cs:<lines> (CanonicalVars and the pickup hook)"
 },
